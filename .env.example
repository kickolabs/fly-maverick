# Copy to .env for local development. Never commit real secrets.
# Server / TanStack Start (used by content.functions.ts and enquiries)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Vite client (browser). Keep publishable key only — never put service role here.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: server admin client only (src/integrations/supabase/client.server.ts)
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Drizzle Kit migrate URL (drizzle.config.ts) — migration role connection string
# LOVABLE_DB_MIGRATION_URL=
